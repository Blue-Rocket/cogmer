#!/usr/bin/env bash
# Refuses to push a commit whose tree the whole suite has not passed on this clone.
# A tree that scripts/test-and-record.sh recorded goes through at once. Any other commit,
# such as a merge or a rebased one, is checked out into a temporary worktree and the
# suite runs on exactly that commit, which takes some minutes.
#
# Git runs it from .githooks because each clone sets core.hooksPath to .githooks, which
# the project's Claude Code settings do at every session start. `git push --no-verify`
# skips it.
set -u
dir="$(git rev-parse --git-dir)/suite-passed"
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  tree=$(git rev-parse "$local_sha^{tree}") || { status=1; continue; }
  [ -e "$dir/$tree" ] && continue
  if ! command -v go >/dev/null 2>&1; then
    echo "pre-push: go is not on PATH, so the suite cannot run on $local_sha" >&2
    status=1; continue
  fi
  work=$(mktemp -d) || { status=1; continue; }
  echo "pre-push: the suite has not passed on $local_sha here; running it on that commit" >&2
  if git worktree add --quiet --detach "$work/tree" "$local_sha" &&
     (cd "$work/tree" && go test -count=1 ./... > "$work/test.log" 2>&1); then
    mkdir -p "$dir" && touch "$dir/$tree"
    echo "pre-push: the suite passed on $local_sha" >&2
  else
    echo "pre-push: the suite failed on $local_sha:" >&2
    grep -E '^(--- FAIL|FAIL|panic)' "$work/test.log" >&2
    echo "pre-push: the whole log is $work/test.log" >&2
    status=1
  fi
  git worktree remove --force "$work/tree" 2>/dev/null
done
exit $status
