{
  "description": "Calls the plugin's own remote server from mcp_tool hooks on UserPromptSubmit, after any call to a probe tool, and at Stop, and records in a file in the sandbox that each event's hooks ran.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/mark.sh\" UserPromptSubmit",
            "timeout": 15
          },
          {
            "type": "mcp_tool",
            "server": "plugin:cogmer-connector-probe:remote",
            "tool": "ping",
            "input": {
              "via": "hook v6 UserPromptSubmit plugin remote",
              "session": "${session_id}"
            },
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/mark.sh\" PostToolUse",
            "timeout": 15
          },
          {
            "type": "mcp_tool",
            "server": "plugin:cogmer-connector-probe:remote",
            "tool": "ping",
            "input": {
              "via": "hook v6 PostToolUse plugin remote",
              "session": "${session_id}"
            },
            "timeout": 25
          }
        ],
        "matcher": "mcp__plugin_cogmer-connector-probe_remote__ping|mcp__cprobe__ping|mcp__claude_ai_cprobe__ping"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/mark.sh\" Stop",
            "timeout": 15
          },
          {
            "type": "mcp_tool",
            "server": "plugin:cogmer-connector-probe:remote",
            "tool": "ping",
            "input": {
              "via": "hook v6 Stop plugin remote",
              "session": "${session_id}"
            },
            "timeout": 25
          }
        ]
      }
    ]
  }
}